{
  "name": "cookie-monster",
  "version": "1.2.0",
  "description": "Browser extension to block cookie consent dialogs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "compile": "tsx scripts/compile-rules.ts",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoellner/cookie-monster.git"
  },
  "author": "Andreas Zoellner",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zoellner/cookie-monster/issues"
  },
  "homepage": "https://github.com/zoellner/cookie-monster#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "oxlint": "^1.79.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wxt": "^0.20.18"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "esbuild": "^0.28.1",
    "shell-quote": "^1.8.5",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1"
  }
}
